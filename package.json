{
  "name": "woms",
  "private": true,
  "type": "module",
  "scripts": {
    "test:coverage": "npm run test:go:coverage && npm run test:web:coverage",
    "test:go:coverage": "./scripts/go-coverage.sh",
    "test:web": "node --test web/*.test.mjs deploy/helm/woms/*.test.mjs",
    "test:web:coverage": "c8 --all --include='web/*.js' --reporter=text --reporter=lcov node --test web/*.test.mjs deploy/helm/woms/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "c8": "^11.0.0"
  }
}
